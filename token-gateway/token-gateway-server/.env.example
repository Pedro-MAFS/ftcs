# Token Gateway Server 环境变量示例（复制为 .env 或导出到 shell）

SERVER_PORT=8088

# MySQL（G0-02 联库后使用）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=token_gateway
MYSQL_USER=root
MYSQL_PASSWORD=

# 用户中心 Issuer（G0-05）
UC_ISSUER_URI=https://user.ai-utills.com

# DeepSeek 上游（G0-03）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
