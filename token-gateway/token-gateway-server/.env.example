# Token Gateway Server 环境变量示例（复制为 .env 或导出到 shell）

SERVER_PORT=8088

# MySQL（profile=local 联库 + Flyway）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=token_gateway
MYSQL_USER=root
MYSQL_PASSWORD=

# API Key 哈希 pepper（G0-06/08；生产必填，勿入库）
GATEWAY_KEY_PEPPER=

# 用户中心 Issuer（G0-05）
UC_ISSUER_URI=https://user.ai-utills.com

# DeepSeek 上游（G0-03）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
