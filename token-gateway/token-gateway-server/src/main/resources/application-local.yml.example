# 复制为 application-local.yml（勿提交）后启动：
#   mvn -pl token-gateway-server spring-boot:run "-Dspring-boot.run.profiles=local"
#
# 骨架默认已排除 DataSource/MyBatis，无 MySQL 也可起。
# 联库时取消下方 datasource 注释，并去掉 TokenGatewayApplication 上对应 exclude。

spring:
  application:
    name: token-gateway-server-local

# spring:
#   datasource:
#     url: jdbc:mysql://${MYSQL_HOST:127.0.0.1}:${MYSQL_PORT:3306}/${MYSQL_DATABASE:token_gateway}?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
#     username: ${MYSQL_USER:root}
#     password: ${MYSQL_PASSWORD:}
#     driver-class-name: com.mysql.cj.jdbc.Driver
#
# management:
#   health:
#     db:
#       enabled: true

token-gateway:
  upstream:
    deepseek:
      api-key: ${DEEPSEEK_API_KEY:}
      base-url: ${DEEPSEEK_BASE_URL:https://api.deepseek.com}
  user-center:
    issuer-uri: ${UC_ISSUER_URI:https://user.ai-utills.com}
