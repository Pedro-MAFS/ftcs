# 复制为 application-local.yml（勿提交）后：--spring.profiles.active=local
#
# 可以和其它服务共库（如 oauth 同实例同库）：业务表有 token_ 前缀，Flyway 历史表为 token_flyway_schema_history。
# 填你的 JDBC 即可，无需再为本地单独建库。

spring:
  application:
    name: token-gateway-server-local
  datasource:
    url: jdbc:mysql://${MYSQL_HOST:127.0.0.1}:${MYSQL_PORT:3306}/${MYSQL_DATABASE:token_gateway}?useUnicode=true&characterEncoding=utf8&connectionTimeZone=UTC&serverTimezone=UTC
    username: ${MYSQL_USER:root}
    password: ${MYSQL_PASSWORD:}

# US-G0-05：与用户中心 AS 相同的 OAuth JWT 密钥（HS256）。勿把真实密钥提交进仓库。
# 构建/运行须加 -Puc-rs。
# com.mfs.user.oauth:
#   issuer: ${UC_ISSUER_URI:https://user.ai-utills.com}
#   jwk-key: ${OAUTH_JWK_KEY}

# US-G0-06：签发/重置 Key 时哈希用 pepper（生产必填）。勿把真实 pepper 提交进仓库。
# token-gateway:
#   key:
#     pepper: ${GATEWAY_KEY_PEPPER:dev-only-pepper-change-me}

# 日志（可选）
# logging:
#   file:
#     path: logs
#   level:
#     com.mfs.tokengateway: DEBUG
