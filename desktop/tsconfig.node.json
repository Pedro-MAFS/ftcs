{
  "include": [
    "electron.vite.config.*",
    "electron/**/*"
  ],
  "compilerOptions": {
    "composite": true,
    "types": ["node"],
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true
  }
}
