# 真实环境变量请放在工作区 .env（不会被模板同步覆盖）
# 复制示例：
#   copy workspace\.env.example <你的工作区>\.env
#
# 模型相关：
#   FTCS_PROVIDER_ID / FTCS_MODEL / FTCS_SMALL_MODEL / *_API_KEY / FTCS_MODEL_BASE_URL
# 搜索相关：
#   SEARCH_PROVIDER / TAVILY_API_KEY / SEARCH_DAILY_LIMIT
# R3 地图发现（可选，仅跑 R3 时需要）：
#   GOOGLE_PLACES_API_KEY / PLACES_PROVIDER=custom
#   FTCS_GOOGLE_PROXY_MODE=system|manual|off  （默认 system：跟随 Windows 系统代理）
#   FTCS_GOOGLE_PROXY_URL=http://127.0.0.1:7890  （manual 模式时填写）
#   须在 GCP 启用 Places API (New)
# 联系人补全（可选，Hunter BYOK）：
#   HUNTER_API_KEYS=key1,key2   （推荐；多 Key 逗号分隔）
#   HUNTER_API_KEY=             （兼容单 Key；与多 Key 并存时排在其后）

SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
SEARCH_DAILY_LIMIT=50
GOOGLE_PLACES_API_KEY=
PLACES_PROVIDER=custom
FTCS_GOOGLE_PROXY_MODE=system
FTCS_GOOGLE_PROXY_URL=
HUNTER_API_KEYS=
# HUNTER_API_KEY=
