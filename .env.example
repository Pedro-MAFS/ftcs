# 真实环境变量请放在工作区 .env（不会被模板同步覆盖）
# 复制示例：
#   copy workspace\.env.example <你的工作区>\.env
#
# 模型相关：
#   FTCS_PROVIDER_ID / FTCS_MODEL / FTCS_SMALL_MODEL / *_API_KEY / FTCS_MODEL_BASE_URL
# 搜索相关：
#   SEARCH_PROVIDER / TAVILY_API_KEY / SEARCH_DAILY_LIMIT

SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
SEARCH_DAILY_LIMIT=50
