# 环境
.env
.env.local
.env.development
.env.production
.env.*.local
workspace/.env
workspace/.env.*
node_modules/
__pycache__/
*.pyc
dist/
.venv/
*.egg-info/

# 标准工作流目录 workspace/：业务数据 gitignore；skills/mcp/config 可纳入版本库
workspace/data/products/*
!workspace/data/products/_example/
workspace/data/library/
workspace/data/leads/
workspace/data/emails/
workspace/data/keywords/
workspace/data/exploration/
workspace/data/cache/
workspace/logs/

# 仓库根不再放置 skills/ mcp-servers/ 运行时副本
/skills/
/mcp-servers/
/data/
/logs/

# IDE / 工具本地目录（不进仓库）
.cursor/                 # Cursor 本机临时接线
!.cursor/skills/
!.cursor/skills/**/
.opencode/               # OpenCode 本机缓存/插件（跑 serve 时自动生成）
workspace/.opencode/     # 不再使用；Skills 只用 workspace/skills
.idea/
*.swp
.DS_Store
Thumbs.db

# 测试与构建
coverage/
*.log
tsconfig.node.tsbuildinfo

# 桌面端构建 / 发版产物
desktop/out/
desktop/release/
desktop/resources/workspace-template/

# electron-builder 本机缓存（可放在任意盘）
/electron-builder-cache/