{
  "name": "@ftcs/places-api",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "description": "MCP server for Google Places API (New) — R3 map discovery BYOK",
  "bin": {
    "places-api": "./dist/mcp.js"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/mcp.js --external:undici --external:socks-proxy-agent",
    "build:tsc": "tsc",
    "start": "node dist/mcp.js",
    "dev": "npm run build && node dist/mcp.js",
    "test": "npm run build:tsc && node --test dist/custom.test.js dist/cache.test.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "socks-proxy-agent": "^8.0.5",
    "undici": "^6.21.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "esbuild": "^0.25.5",
    "typescript": "^5.8.2"
  }
}
