{
  "name": "@ftcs/search-api",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "description": "MCP server for web search via Tavily",
  "bin": {
    "search-api": "./dist/mcp.js"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/mcp.js",
    "build:tsc": "tsc",
    "start": "node dist/mcp.js",
    "dev": "npm run build && node dist/mcp.js",
    "test": "npm run build:tsc && node --test dist/tavily.test.js dist/cache.test.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "esbuild": "^0.25.5",
    "typescript": "^5.8.2"
  }
}
