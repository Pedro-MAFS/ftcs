EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=
FROM_NAME=
DAILY_SEND_LIMIT=20

CRAWL_DELAY_MS=1000
CRAWL_MAX_PAGES=20
