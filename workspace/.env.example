# 复制为 .env 后填入真实 Key
# copy .env.example .env
#
# 说明：
# - 本文件是【用户偏好】，模板同步不会覆盖
# - opencode.json 是【托管模板】（skills / mcp），会被模板版本更新覆盖

# —— 模型（设置页写入）——
# FTCS_PROVIDER_ID=anthropic|openai|google|custom
FTCS_PROVIDER_ID=anthropic
FTCS_MODEL=anthropic/claude-sonnet-4-5
FTCS_SMALL_MODEL=anthropic/claude-haiku-4-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# 自定义兼容端点
FTCS_CUSTOM_API_KEY=
FTCS_MODEL_BASE_URL=

# —— 搜索 ——
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
SERPAPI_API_KEY=
SEARCH_DAILY_LIMIT=50

EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=
FROM_NAME=
DAILY_SEND_LIMIT=20

CRAWL_DELAY_MS=1000
CRAWL_MAX_PAGES=20
