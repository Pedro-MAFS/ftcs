# 复制为 workspace/.env 后填入真实 Key
# copy .env.example .env

# —— 模型提供商（OpenCode 读取）——
# FTCS_PROVIDER_ID=anthropic|openai|google|custom
FTCS_PROVIDER_ID=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# 自定义兼容端点
FTCS_CUSTOM_API_KEY=
FTCS_MODEL_BASE_URL=

# —— 搜索 ——
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
