{
  "$schema": "https://opencode.ai/config.json",
  "model": "anthropic/claude-sonnet-4-5",
  "small_model": "anthropic/claude-haiku-4-5",
  "skills": {
    "paths": ["skills"]
  },
  "permission": {
    "*": "ask",
    "skill": { "*": "allow" },
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "question": "allow",
    "todowrite": "allow",
    "doom_loop": "allow",
    "lead-store_*": "allow",
    "search-api_*": "allow",
    "places-api_*": "allow",
    "hunter-api_*": "allow",
    "chrome-devtools_*": "allow",
    "edit": "deny",
    "bash": "deny",
    "external_directory": "deny",
    "lsp": "deny",
    "webfetch": "ask",
    "websearch": "ask",
    "task": "ask"
  },
  "mcp": {
    "lead-store": {
      "type": "local",
      "command": ["node", "mcp-servers/lead-store/dist/mcp.js"],
      "enabled": true,
      "environment": {
        "FTCS_WORKSPACE": "."
      }
    },
    "search-api": {
      "type": "local",
      "command": ["node", "mcp-servers/search-api/dist/mcp.js"],
      "enabled": true,
      "environment": {
        "FTCS_WORKSPACE": ".",
        "SEARCH_PROVIDER": "tavily",
        "SEARCH_DAILY_LIMIT": "50"
      }
    },
    "places-api": {
      "type": "local",
      "command": ["node", "mcp-servers/places-api/dist/mcp.js"],
      "enabled": true,
      "environment": {
        "FTCS_WORKSPACE": ".",
        "PLACES_PROVIDER": "custom"
      }
    },
    "hunter-api": {
      "type": "local",
      "command": ["node", "mcp-servers/hunter-api/dist/mcp.js"],
      "enabled": true,
      "environment": {
        "FTCS_WORKSPACE": "."
      }
    },
    "chrome-devtools": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@1.6.0",
        "--browserUrl",
        "http://127.0.0.1:0"
      ],
      "enabled": true
    }
  }
}
