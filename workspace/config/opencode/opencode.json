{
  "$schema": "https://opencode.ai/config.json",
  "model": "anthropic/claude-sonnet-4-5",
  "small_model": "anthropic/claude-haiku-4-5",
  "skills": {
    "paths": ["skills"]
  },
  "permission": {
    "skill": {
      "*": "allow"
    }
  },
  "mcp": {
    "lead-store": {
      "type": "local",
      "command": ["node", "mcp-servers/lead-store/dist/mcp.js"],
      "enabled": true,
      "environment": {
        "FTCS_WORKSPACE": "."
      }
    },
    "search-api": {
      "type": "local",
      "command": ["node", "mcp-servers/search-api/dist/mcp.js"],
      "enabled": true,
      "environment": {
        "FTCS_WORKSPACE": ".",
        "SEARCH_PROVIDER": "tavily",
        "SEARCH_DAILY_LIMIT": "50"
      }
    },
    "places-api": {
      "type": "local",
      "command": ["node", "mcp-servers/places-api/dist/mcp.js"],
      "enabled": true,
      "environment": {
        "FTCS_WORKSPACE": ".",
        "PLACES_PROVIDER": "custom"
      }
    },
    "chrome-devtools": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@1.6.0",
        "--isolated"
      ],
      "enabled": true
    }
  }
}
