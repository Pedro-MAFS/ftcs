{
  "$schema": "https://opencode.ai/config.json",
  "skills": {
    "paths": ["skills"]
  },
  "permission": {
    "skill": {
      "*": "allow"
    }
  },
  "mcp": {
    "lead-store": {
      "type": "local",
      "command": ["node", "mcp-servers/lead-store/dist/index.js"],
      "enabled": true,
      "environment": {
        "FTCS_WORKSPACE": "."
      }
    },
    "search-api": {
      "type": "local",
      "command": ["node", "mcp-servers/search-api/dist/index.js"],
      "enabled": true,
      "environment": {
        "FTCS_WORKSPACE": ".",
        "SEARCH_PROVIDER": "tavily",
        "SEARCH_DAILY_LIMIT": "50"
      }
    }
  }
}
